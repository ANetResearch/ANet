# The installers are published as the bytes that were signed; a checkout on
# Windows must not change them (no CRLF conversion).
deploy/release/install.ps1 -text
deploy/release/*.sh text eol=lf
# The Windows launchers of the agent plugins are batch files with CRLF line
# ends, generated byte for byte (deploy/plugins/build.py --check); a checkout
# must not convert them.
deploy/plugins/**/*.cmd -text
deploy/plugins/**/*.ps1 -text
