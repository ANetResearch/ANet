(version 1)
(deny default)

; the Seatbelt profile of one sandboxed anet run: paths and a port only

; processes
(allow process-fork)
(allow process-exec
  (subpath "/bin")
  (subpath "/usr/bin")
  (subpath "/Library/Developer/CommandLineTools")
  (literal "/usr/libexec/path_helper")
  (literal "/Users/u/.local/bin/anet")
  (subpath "/Users/u/.local/bin")
  (subpath "/Users/u/.local/share/claude/versions/1.0.0")
  (subpath "/opt/homebrew/Cellar/node/22.1.0/bin")
  (subpath "/Users/u/Library/Caches/anet/work-sandbox/EaidForGolden001/ix-golden")
)
(deny process-info*)
(allow process-info* (target same-sandbox))
(allow signal (target same-sandbox))
(allow sysctl-read)

; files
(allow file-read-metadata)
(allow file-read*
  (subpath "/bin")
  (subpath "/sbin")
  (subpath "/usr/bin")
  (subpath "/usr/sbin")
  (subpath "/usr/lib")
  (subpath "/usr/libexec")
  (subpath "/usr/share")
  (subpath "/System/Library")
  (subpath "/System/Cryptexes")
  (subpath "/System/Volumes/Preboot/Cryptexes")
  (subpath "/Library/Developer/CommandLineTools")
  (subpath "/private/var/db/timezone")
  (subpath "/private/var/select/sh")
  (subpath "/private/etc/hosts")
  (subpath "/private/etc/passwd")
  (subpath "/private/etc/group")
  (subpath "/private/etc/protocols")
  (subpath "/private/etc/services")
  (subpath "/private/etc/shells")
  (subpath "/private/etc/localtime")
  (subpath "/private/etc/ssl")
  (subpath "/private/etc/paths")
  (subpath "/private/etc/paths.d")
  (subpath "/private/etc/profile")
  (subpath "/private/etc/bashrc")
  (subpath "/private/etc/zshenv")
  (subpath "/private/etc/zprofile")
  (subpath "/private/etc/zshrc")
  (literal "/dev/null")
  (literal "/dev/zero")
  (literal "/dev/random")
  (literal "/dev/urandom")
  (literal "/dev/stdin")
  (literal "/dev/stdout")
  (literal "/dev/stderr")
  (literal "/dev/dtracehelper")
  (literal "/dev/autofs_nowait")
  (subpath "/dev/fd")
  (literal "/Users/u/.local/bin/anet")
  (subpath "/Users/u/.local/bin")
  (subpath "/Users/u/.local/share/claude/versions/1.0.0")
  (subpath "/opt/homebrew/Cellar/node/22.1.0/bin")
  (subpath "/opt/homebrew/Cellar")
  (subpath "/Users/u/Library/Caches/anet/run/Golden01-0123456789")
  (subpath "/Users/u/Library/Caches/anet/work-sandbox/EaidForGolden001/ix-golden")
)
(allow file-write*
  (subpath "/Users/u/Library/Caches/anet/work-sandbox/EaidForGolden001/ix-golden")
  (subpath "/Users/u/Library/Caches/anet/run/Golden01-0123456789/home")
  (subpath "/Users/u/Library/Caches/anet/run/Golden01-0123456789/tmp")
  (literal "/dev/null")
  (literal "/dev/stdout")
  (literal "/dev/stderr")
  (subpath "/dev/fd")
)
(allow file-ioctl
  (literal "/dev/null")
  (literal "/dev/zero")
  (literal "/dev/random")
  (literal "/dev/urandom")
  (literal "/dev/dtracehelper")
)

; IPC
(allow system-socket (socket-domain AF_UNIX))
(allow mach-lookup
  (global-name "com.apple.system.opendirectoryd.libinfo")
  (global-name "com.apple.system.opendirectoryd.membership")
  (global-name "com.apple.system.notification_center")
  (global-name "com.apple.system.logger")
  (global-name "com.apple.logd")
)

; network
(allow network-outbound (remote ip "localhost:49152"))

; refused whatever is allowed above (a later rule wins)
(deny process-exec
  (literal "/usr/bin/security")
  (literal "/usr/bin/osascript")
  (literal "/usr/bin/open")
)
(deny mach-lookup
  (global-name "com.apple.SecurityServer")
  (global-name-prefix "com.apple.securityd")
  (global-name-prefix "com.apple.secd")
  (global-name-prefix "com.apple.security.")
  (global-name-prefix "com.apple.trustd")
  (global-name-prefix "com.apple.pasteboard")
  (global-name "com.apple.coreservices.launchservicesd")
  (global-name-prefix "com.apple.lsd.")
  (global-name-prefix "com.apple.tccd")
  (global-name-prefix "com.apple.windowserver")
)
(deny sysctl-read
  (sysctl-name-prefix "kern.procargs")
)
(deny file-link)
(deny file-clone)
(deny nvram*)
(deny mach-cross-domain-lookup)
(deny iokit-get-properties)
(deny darwin-notification-post)
(deny socket-ioctl)
(deny system-fcntl (fcntl-command 80 110))
(deny network-bind)
(deny network-inbound)
(deny appleevent-send)
