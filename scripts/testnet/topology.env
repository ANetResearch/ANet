# shellcheck shell=bash
# topology.env — 联调测试网的推荐拓扑。build.sh / deploy.sh / teardown.sh / bridge.sh 都 source 它。
#
# 依据 docs/notes/0015-测试网主机勘察.md(2026-09-27 只读勘察)。结论先放在这里,改拓扑前先读它:
#
#   两个互不连通的"岛":
#     lab    10.2.2.0/24     ink88(本机,编排机)、Ink89、Ink90。三台之间任意 TCP 端口互通;出口经 NAT,
#                            外部进不来。89/90 各 2 核 / 3.8G 内存 / 11G 可用盘。
#     campus 210.45.70.0/23  dmax(gpu2)与 cmax,同一网段,另有 zerotier 覆盖网 10.253.20.0/24。
#                            dmax 无主机防火墙;cmax 开着 ufw(INPUT DROP,47xxx 未放行,入站不通)。
#   两岛之间没有直连:89/90 连不到 cmax/dmax 的任何地址,cmax/dmax 也连不到 10.2.2.x。
#   只有 ink88 两边都通:局域网到 89/90,zerotier(10.253.20.2)到 dmax 的任意端口、到 cmax 的 ufw 放行端口。
#
#   因此:lab 岛里做 hub1↔hub2 联邦(真跨主机);campus 岛里 hub3 在 dmax,cmax 上的 daemon 走真实的
#   "入站被防火墙挡住"路径(p2p 被拒后应回落到 hub 中继);跨岛联邦只能经 ink88 转发(bridge.sh fed-up)。
#
#   SSH:cmax.anet.chat / dmax.anet.chat 在本机解析不到;cmax/dmax.chatchat.space 解析到公网地址但 22 口
#   从 lab 过去超时。能用的是 zerotier 地址 root@10.253.20.9(cmax)、root@10.253.20.5(dmax)。
#   10.2.2.89/90 的 root 不接受本机密钥,只有 ink@ 可登录且 sudo 要密码 —— 所以这两台走"用户模式"
#   (~/anet-testnet,setsid + pid 文件,无 systemd 单元)。若产品负责人把本机公钥加进 root,
#   把下面 ssh 目标改成 root@ 即自动切到"系统模式"(/opt/anet-testnet + systemd 瞬态单元)。

# 运行标识。目录 <base>/<run-id>/ 与单元名 anet-testnet-<run-id>-<节点>[-peer|-backend|-admin] 都带它。
# 只允许 [a-z0-9-],以字母或数字开头,最长 24。
TESTNET_RUN_ID=${TESTNET_RUN_ID:-tn1}

# 固定前缀。teardown.sh 只停这个前缀的单元、只删 anet-testnet 目录。不要改。
TESTNET_UNIT_PREFIX=anet-testnet

# 端口段。勘察时四台主机与 ink88 的 TCP 47000-47999 全部空闲(cmax 有 UDP 47780、ink88 有 UDP 47077,
# 都是 UDP、都不在下面用到的范围)。每台主机一个百位段,端口在整个测试网里唯一 —— 这样 bridge.sh
# 可以把远端 loopback 上的控制口原号映射到本机,脚本里 127.0.0.1:<port> 的写法不必改号。
#   47x01 hub    47x11-47x19 daemon 控制口    47x31-47x39 anetpeer    47x41-47x49 official(控制口,
#   其后端 = 控制口+1)    47x51 hub-admin(= hub 端口+50,仅 loopback)
#   47x61-47x69 / 47x91-47x99 daemon / official 的本机 A2A 接口(= 控制口+50,仅 loopback;module/a2a
#   默认开启,不钉住时首启从 43811 起自选,出段)
TESTNET_PORT_MIN=47100
TESTNET_PORT_MAX=47499

# 主机表。列:别名  ssh目标  GOARCH  拨号地址(别的节点连它用)  绑定地址(hub/anetpeer 监听)  岛
# 绑定地址不用 0.0.0.0:dmax/cmax 上有几十个 docker 网桥与公网网卡,只绑需要的那一个。
# dmax 默认绑 zerotier 地址(不暴露到公网);要测真正的公网地址路径,把 dmax 两列改成 210.45.70.176
# (cmax 与 dmax 同在 210.45.70.0/23,这条路径不经过 NAT,只是"非覆盖网"的地址)。
TESTNET_HOSTS="
ink89  ink@10.2.2.89      amd64  10.2.2.89     10.2.2.89     lab
ink90  ink@10.2.2.90      amd64  10.2.2.90     10.2.2.90     lab
dmax   root@10.253.20.5   amd64  10.253.20.5   10.253.20.5   campus
cmax   root@10.253.20.9   amd64  10.253.20.9   10.253.20.9   campus
"

# 节点表。列:名称  角色  主机  端口  所属hub  p2p端口  二进制
#   角色 hub:端口 = 监听端口;所属hub/p2p/二进制填 -
#   角色 daemon:端口 = 控制口(只绑 127.0.0.1);p2p端口非 - 时起一个 anetpeer(绑主机的绑定地址,
#     以 hub 作 rendezvous);二进制 = build.sh 产出的 anet 或 anet-<变体>
#   角色 official:同 daemon,另起 anet-official 后端在 127.0.0.1:<端口+1>
# 名称只允许 [a-z0-9],它进单元名和目录名。
TESTNET_NODES="
hub1   hub       ink89  47101  -     -      -
d1a    daemon    ink89  47111  hub1  47131  anet
d1b    daemon    ink89  47112  hub1  47132  anet
hub2   hub       ink90  47201  -     -      -
d2a    daemon    ink90  47211  hub2  47231  anet
d2b    daemon    ink90  47212  hub2  -      anet
off2   official  ink90  47241  hub2  -      anet
hub3   hub       dmax   47301  -     -      -
d3a    daemon    dmax   47311  hub3  47331  anet
d4a    daemon    cmax   47411  hub3  47431  anet
d4b    daemon    cmax   47412  hub3  -      anet
"

# 联邦对(同岛,直连)。deploy.sh federate 为每对写双方的 federation.json 并重启这两个 hub。
TESTNET_FEDERATION="
hub1 hub2
"

# 跨岛联邦对。只有 FEDERATE_BRIDGED=1 时才写进 federation.json,且必须先 bridge.sh fed-up:
# 对端地址写成 ink88 在本岛的地址(下面两行),由 ink88 上的 ssh -L 转发到对岸。
TESTNET_FEDERATION_BRIDGED="
hub1 hub3
"
TESTNET_BRIDGE_ADDR_lab=10.2.2.88
TESTNET_BRIDGE_ADDR_campus=10.253.20.2

# official 节点 = anet-official 后端(cmd/anet-official,serve)+ 一个 daemon 身份(deploy/official 的形态)。
#   TESTNET_OFFICIAL_GROUPS  后端服务的能力组(anet-official capabilities 列出:echo tools docs paid)。
#                            测试网只有一个 official 身份,所以默认把免费组与付费演示放在一起;生产按
#                            deploy/official 一组一个身份。
#   TESTNET_OFFICIAL_ARGS    后端参数。{PORT} = 后端端口(控制口+1),{GROUPS} = 上一项,{TOKEN_FILE} = 节点
#                            目录里的后端令牌(首次部署时在远端生成,0600,不出主机;daemon 的 service 模块
#                            以 token_file 读同一个文件)。
#   TESTNET_OFFICIAL_CONFIG  daemon config.json 模板(本机路径)。空 = 在远端由 `anet-official service-config`
#                            生成(inbound closed + public_capabilities + modules.service;含 paid 组时加 x402
#                            模块),与 deploy/official 同源。模板占位符:{CONTROL_ADDR} {HUB_URL}
#                            {BACKEND_URL} {NAME} {TOKEN_FILE}。
TESTNET_OFFICIAL_GROUPS=${TESTNET_OFFICIAL_GROUPS:-echo,tools,paid}
TESTNET_OFFICIAL_ARGS=${TESTNET_OFFICIAL_ARGS:-"serve -listen 127.0.0.1:{PORT} -token-file {TOKEN_FILE} -groups {GROUPS}"}
TESTNET_OFFICIAL_CONFIG=${TESTNET_OFFICIAL_CONFIG:-}

# 本机构建产物与状态目录。
TESTNET_BUILD_DIR=${TESTNET_BUILD_DIR:-}
TESTNET_STATE=${TESTNET_STATE:-${XDG_CACHE_HOME:-$HOME/.cache}/anet-testnet/$TESTNET_RUN_ID}
