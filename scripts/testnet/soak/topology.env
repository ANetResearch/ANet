# shellcheck shell=bash
# soak/topology.env — 长稳测试(scripts/testnet/soak.sh,docs/notes/0036)用的拓扑:只用 lab 岛两台主机。
# 结构与 ../topology.env 相同(同一套 deploy.sh/teardown.sh 读它),差别:
#   - 运行标识 soak(目录 ~/anet-testnet/soak/,与联调用的 tn1 分开);
#   - 每台 3–4 个 daemon,覆盖 p2p 两端都有(d1a⇄d2a)、只一端有(d2c→d1c)、都没有(d1b→d2b)与官方节点;
#   - 本机 A2A 接口不放在控制口+50,由 soak.sh 预写 a2a_addr.txt 钉在 47400 段(见 SOAK_A2A_PORTS)。
TESTNET_RUN_ID=${TESTNET_RUN_ID:-soak}
TESTNET_UNIT_PREFIX=anet-testnet
TESTNET_PORT_MIN=47100
TESTNET_PORT_MAX=47499

TESTNET_HOSTS="
ink89  ink@10.2.2.89      amd64  10.2.2.89     10.2.2.89     lab
ink90  ink@10.2.2.90      amd64  10.2.2.90     10.2.2.90     lab
"

# 名称  角色  主机  端口  所属hub  p2p端口  二进制
#   d1a  请求方,带 anetpeer(与 d2a 直连)       d1b  请求方,只走 hub(付款方)
#   d1c  提供方,带 anetpeer(d2c 发来的任务只一端有 p2p,走 hub)
#   d2a  提供方,带 anetpeer                     d2b  提供方,只走 hub(能力、付费能力、自动回复)
#   d2c  请求方,只走 hub(付款方,agent 档)     off2 官方节点(anet-official 后端在 Unix socket 上)
TESTNET_NODES="
hub1   hub       ink89  47101  -     -      -
d1a    daemon    ink89  47111  hub1  47131  anet
d1b    daemon    ink89  47112  hub1  -      anet
d1c    daemon    ink89  47113  hub1  47133  anet
hub2   hub       ink90  47201  -     -      -
d2a    daemon    ink90  47211  hub2  47231  anet
d2b    daemon    ink90  47212  hub2  -      anet
d2c    daemon    ink90  47213  hub2  -      anet
off2   official  ink90  47241  hub2  -      anet
"

TESTNET_FEDERATION="
hub1 hub2
"
TESTNET_FEDERATION_BRIDGED=""
TESTNET_OFFICIAL_GROUPS=${TESTNET_OFFICIAL_GROUPS:-echo,tools,paid}
TESTNET_OFFICIAL_ARGS=${TESTNET_OFFICIAL_ARGS:-"serve -listen unix:{SOCKET} -token-file {TOKEN_FILE} -groups {GROUPS}"}
TESTNET_OFFICIAL_CONFIG=${TESTNET_OFFICIAL_CONFIG:-}
TESTNET_BUILD_DIR=${TESTNET_BUILD_DIR:-}
TESTNET_STATE=${TESTNET_STATE:-${XDG_CACHE_HOME:-$HOME/.cache}/anet-testnet/$TESTNET_RUN_ID}

# 本机 A2A 接口端口(47400 段,仅 loopback)。soak.sh 在首次部署前预写各节点的 a2a_addr.txt。
SOAK_A2A_PORTS="
d1a 47461
d1b 47462
d1c 47463
d2a 47471
d2b 47472
d2c 47473
off2 47474
"
