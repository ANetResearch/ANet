+// runMonitor is the MUTATION's restored ai-studio source: the official agent's jobs, fetched through
+// its console with its token, appended under datasets/<id>/ and indexed as sessions.
+func (hv *Harvester) runMonitor(ctx context.Context, m *Manifest) RunResult {
+	res := RunResult{Source: m.ID}
+	tok, err := os.ReadFile(m.Monitor.TokenFile)
+	if err != nil {
+		res.Err = err.Error()
+		return res
+	}
+	body := []byte(`{"include_artifacts":true,"history_length":50,"page_size":100}`)
+	req, err := http.NewRequestWithContext(ctx, http.MethodPost, strings.TrimRight(m.Monitor.URL, "/")+"/tasks/list",
+		bytes.NewReader(body))
+	if err != nil {
+		res.Err = err.Error()
+		return res
+	}
+	req.Header.Set("Content-Type", "application/json")
+	req.Header.Set("Authorization", "Bearer "+strings.TrimSpace(string(tok)))
+	resp, err := (&http.Client{Timeout: 20 * time.Second}).Do(req)
+	if err != nil {
+		res.Err = err.Error()
+		return res
+	}
+	raw, _ := io.ReadAll(io.LimitReader(resp.Body, 16<<20))
+	resp.Body.Close()
+	var page struct {
+		Tasks []json.RawMessage `json:"tasks"`
+	}
+	if err := json.Unmarshal(raw, &page); err != nil {
+		res.Err = fmt.Sprintf("monitor answered %d: %v", resp.StatusCode, err)
+		return res
+	}
+	dir := filepath.Join(hv.root, m.ID, "sessions")
+	if err := os.MkdirAll(dir, 0o755); err != nil {
+		res.Err = err.Error()
+		return res
+	}
+	for _, t := range page.Tasks {
+		var head struct {
+			ID string `json:"id"`
+		}
+		_ = json.Unmarshal(t, &head)
+		if head.ID == "" {
+			continue
+		}
+		data := filepath.Join(dir, safeSessionID(head.ID)+".jsonl")
+		if err := os.WriteFile(data, append(append([]byte{}, t...), '\n'), 0o644); err != nil {
+			continue
+		}
+		goal := string(t)
+		if len(goal) > 4000 {
+			goal = goal[:4000]
+		}
+		if err := hv.store.putHarvestedSession(m.ID, safeSessionID(head.ID), m.AID, goal, data); err == nil {
+			res.Events++
+		}
+	}
+	res.Sessions = res.Events
+	res.Cursor = "monitor:" + time.Now().UTC().Format(time.RFC3339)
+	return res
+}
+
+func safeSessionID(s string) string {
+	return strings.Map(func(r rune) rune {
+		if r >= 'a' && r <= 'z' || r >= 'A' && r <= 'Z' || r >= '0' && r <= '9' || r == '-' || r == '_' {
+			return r
+		}
+		return '_'
+	}, s)
 }
