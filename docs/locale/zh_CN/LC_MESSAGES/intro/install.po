msgstr "内容寻址存储能力。"

#: ../../intro/install.rst:1352
msgid "``console``"
msgstr "``console``"

#: ../../intro/install.rst:1353
msgid "The local web console."
msgstr "本地 Web 控制台。"

#: ../../intro/install.rst:1354
msgid "``mcp``"
msgstr "``mcp``"

#: ../../intro/install.rst:1355
msgid "The MCP server and the coding agent wiring."
msgstr "MCP 服务器及编程 Agent 的配置。"

#: ../../intro/install.rst:1356
msgid "``org``"
msgstr "``org``"

#: ../../intro/install.rst:1357
