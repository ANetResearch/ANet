#: ../../howto/troubleshooting.rst:487 ../../howto/troubleshooting.rst:549
#: ../../howto/troubleshooting.rst:619
msgid "Cause"
msgstr "原因"

#: ../../howto/troubleshooting.rst:73 ../../howto/troubleshooting.rst:178
#: ../../howto/troubleshooting.rst:240 ../../howto/troubleshooting.rst:322
