msgstr "缺少 ``/usr/bin/sandbox-exec``\\ (macOS)。"

#: ../../howto/troubleshooting.rst:642
msgid "``anet autoreply set --untrusted off``."
msgstr "运行 ``anet autoreply set --untrusted off``\\ 。"

#: ../../howto/troubleshooting.rst:643
msgid "``no_cgroup_limits``"
msgstr "``no_cgroup_limits``"

