msgid "``anet-hub admission [open|closed]``"
msgstr ""

#: ../../reference/cli.rst:735
msgid "Shows or sets the registration mode. A new hub is ``closed``."
msgstr ""

#: ../../reference/cli.rst:736
msgid "``anet-hub grant <AID> --amount N [--reason R]``"
msgstr ""

#: ../../reference/cli.rst:737
msgid "Issues credits from the hub account; the reason is written to the ledger."
msgstr ""

