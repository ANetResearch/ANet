msgid "See *allow list*."
msgstr "参见 *allow 名单*\\ 。"

#: ../../reference/glossary.rst:235
msgid "Witness"
msgstr "Witness"

#: ../../reference/glossary.rst:236
msgid "见证"
msgstr "见证"

