msgstr "``accept_delegations``"

#: ../../reference/config.rst:557
msgid "Use ``anet inbound policy``."
msgstr "请使用 ``anet inbound policy``\\ 。"

#: ../../reference/config.rst:558
msgid "``rotation_grace``"
msgstr "``rotation_grace``"

#: ../../reference/config.rst:559
msgid "The grace period of a scheduled rotation is fixed at 1 hour."
msgstr "定期轮换的宽限期固定为 1 小时。"

#: ../../reference/config.rst:560
msgid "``inbound.allow_file``, ``deny_file``, ``trust_file``"
msgstr "``inbound.allow_file``, ``deny_file``, ``trust_file``"

#: ../../reference/config.rst:561
