msgid "``providers``, ``providers.anetlink``"
msgstr "``providers``, ``providers.anetlink``"

#: ../../reference/config.rst:555
msgid "Use ``modules.anetlink``."
msgstr "请使用 ``modules.anetlink``\\ 。"

#: ../../reference/config.rst:556
