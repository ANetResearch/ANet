msgstr ""

#: ../../topics/delegation.rst:244
msgid "The number of conversation turns sent to the backend."
msgstr ""

#: ../../topics/delegation.rst:245
msgid "``api_timeout_seconds``"
msgstr ""

#: ../../topics/delegation.rst:246
msgid "180"
msgstr ""

#: ../../topics/delegation.rst:247
msgid ""
"The time limit of one backend call, and the wall-clock limit of a sandbox"
" run."
msgstr ""

#: ../../topics/delegation.rst:249
msgid "``sandbox.egress_allow``"
msgstr ""

#: ../../topics/delegation.rst:251
msgid "Hosts that a sandboxed agent may reach. See :doc:`sandbox`."
msgstr ""

#: ../../topics/delegation.rst:252
msgid "``sandbox.runs_per_day``, ``sandbox.runs_per_peer_per_day``"
msgstr ""

#: ../../topics/delegation.rst:253
