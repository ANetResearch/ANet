msgstr ""

#: ../../topics/delegation.rst:214
msgid "``agent``"
msgstr ""

#: ../../topics/delegation.rst:215
msgid "none"
msgstr ""

#: ../../topics/delegation.rst:216
msgid "The coding agent for the ``exec`` backend. Required with ``exec``."
msgstr ""

#: ../../topics/delegation.rst:217
msgid "``untrusted``"
msgstr ""

#: ../../topics/delegation.rst:218
msgid "``off``"
msgstr ""

#: ../../topics/delegation.rst:219
msgid ""
"What the ``exec`` backend does for a peer that is not on the trust list: "
"``off`` leaves the task in the inbox, ``sandbox`` runs the agent in the "
"sandbox."
msgstr ""

#: ../../topics/delegation.rst:222
msgid "``trusted``"
msgstr ""

#: ../../topics/delegation.rst:223
msgid "``direct``"
msgstr ""

#: ../../topics/delegation.rst:224
msgid ""
"How the ``exec`` backend runs for a peer on the trust list: ``direct`` "
"runs the agent as the operator's user, ``sandbox`` runs it in the "
"sandbox."
msgstr ""

