msgstr "``v: 3``"

#: ../../versioning.rst:69
msgid "A frame of another version is not delivered."
msgstr "其他版本的帧不予投递。"

#: ../../versioning.rst:70
msgid "C1 (``anet`` and ANetLink)"
msgstr "C1（``anet`` 与 ANetLink）"

