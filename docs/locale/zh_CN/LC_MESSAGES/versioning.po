msgstr "其他取值均被 Hub（``bad_envelope``）和接收方拒绝。"

#: ../../versioning.rst:64
msgid "Key event log"
msgstr "密钥事件日志"

#: ../../versioning.rst:65
msgid "``anet.kel/2``"
msgstr "``anet.kel/2``"

#: ../../versioning.rst:66
msgid "A log without the tag does not replay."
msgstr "不带该标签的日志无法重放。"

#: ../../versioning.rst:67
msgid "Direct frames"
msgstr "直连帧"

#: ../../versioning.rst:68
