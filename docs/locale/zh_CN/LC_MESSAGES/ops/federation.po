msgstr "按哈希前缀返回本 hub 自有注册的目录条目。"

#: ../../ops/federation.rst:160
msgid "``POST /fed/v3/relay-status``"
msgstr "``POST /fed/v3/relay-status``"

#: ../../ops/federation.rst:161
msgid ""
