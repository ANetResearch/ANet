+def _owes_reply(addr: str, token: str) -> bool:
+    """True while a delegation to this researcher waits for its model's reply."""
+    now = time.time()
+    threads = _daemon_post(addr, token, "/threads", {}, timeout=30).get("threads") or []
+    for th in threads:
+        if th.get("role") != "inbound" or th.get("state") in _TERMINAL_STATES:
+            continue
+        texts = [m for m in th.get("messages") or [] if m.get("kind") == "text"]
+        if not texts or texts[-1].get("from") != "them":
+            continue
+        # A turn cannot run longer than the model deadline; older ones are
+        # abandoned conversations, not a reply in flight.
+        try:
+            from datetime import datetime
+
+            at = datetime.fromisoformat(str(th.get("updated_at", "")).replace("Z", "+00:00")).timestamp()
+        except ValueError:
+            at = now
+        if now - at <= _AGENT_API_TIMEOUT_SEC + 60:
+            return True
+    return False
+
+
+def _wait_reply_idle(addr: str, token: str, wait_sec: int = 30) -> bool:
+    deadline = time.monotonic() + wait_sec
+    while _owes_reply(addr, token):
+        if time.monotonic() >= deadline:
+            return False
+        time.sleep(3)
+    return True
+
