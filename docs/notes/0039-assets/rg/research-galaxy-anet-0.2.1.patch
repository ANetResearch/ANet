+def _is_paused(ident: str) -> bool:
+    return os.path.exists(os.path.join(ANET_HOME, "ids", ident, PAUSED_MARK))
+
+
+def _migrate_pause_flag(ident: str) -> None:
+    """Carry a wire-1 pause over before an anet 0.2 daemon first starts.
+
+    anet 0.2 deletes accept_delegations from config.json on its first start, so
+    a researcher paused under 0.1 (accept_delegations=false) is recorded here,
+    while the key is still there. Requesters were never accepting; not a pause.
+    """
+    if ident.startswith("requester-"):
+        return
+    try:
+        cfg = json.load(open(os.path.join(ANET_HOME, "ids", ident, "config.json")))
+    except Exception:
+        return
+    if cfg.get("accept_delegations") is False and not _is_paused(ident):
+        open(os.path.join(ANET_HOME, "ids", ident, PAUSED_MARK), "w").close()
+
+
+def _requester_aids() -> list[str]:
+    try:
+        eps = json.loads(_r.get(REQUESTERS_KEY) or "[]")
+    except Exception:
+        eps = []
+    if not eps:
+        eps = _provision_requesters()
+    return [ep["aid"] for ep in eps if ep.get("aid")]
+
+
+def _sync_allow(ident: str) -> None:
+    """Keep the requester pool on this researcher's peers.allow (off it while paused)."""
+    path = os.path.join(ANET_HOME, "ids", ident, ALLOW_FILE)
+    try:
+        lines = [ln for ln in open(path).read().splitlines() if ln.strip()]
+    except FileNotFoundError:
+        lines = []
+    listed ={ln.split("#", 1)[0].strip() for ln in lines}
+    pool = set(_requester_aids())
+    if _is_paused(ident):
+        new = [ln for ln in lines if ln.split("#", 1)[0].strip() not in pool]
+    else:
+        new = lines + [a for a in sorted(pool) if a not in listed]
+    if new != lines:
+        tmp = path + ".tmp"
+        with open(tmp, "w") as f:
+            f.write("".join(ln + "\n" for ln in new))
+        os.chmod(tmp, 0o600)
+        os.replace(tmp, path)
+
+
