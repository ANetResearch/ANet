# anet-dmax.service — the dmax-services node on dmax (gpu2), homed at
# https://hub2.agentnetwork.org.cn. prodtest's provider on the second hub:
# text.stats / text.stats.paid are its public capabilities, image.inspect is
# for peers on its allow list. See deploy/ops/README.md.
#
# Hardened as deploy/official/anet-official-daemon@.service: a dedicated
# non-root account (anet-dmax), state under /var/lib/anet-dmax (0700), its
# own runtime directory (XDG_RUNTIME_DIR=/run/anet-dmax, so nothing is written
# to the shared /tmp/anet-0 of root's other daemons), read-only everything
# else. The backend is anet-dmax-svc.service on a Unix socket in a directory
# only this account can write.
#
# The CLI refuses a daemon that runs as another uid (internal/localpeer), so
# commands for this node run as its account: /opt/anet/bin/anet-dmax (a
# wrapper around runuser) — e.g. `anet-dmax status`.
[Unit]
Description=anet daemon dmax-services (hub2.agentnetwork.org.cn)
Documentation=https://github.com/ANetResearch/ANet/tree/main/deploy/ops
Wants=network-online.target anet-dmax-svc.service
After=network-online.target anet-dmax-svc.service

[Service]
Type=simple
User=anet-dmax
Group=anet-dmax
StateDirectory=anet-dmax
StateDirectoryMode=0700
RuntimeDirectory=anet-dmax
RuntimeDirectoryMode=0700
Environment=HOME=/var/lib/anet-dmax
Environment=ANET_DATA_DIR=/var/lib/anet-dmax/.anet
Environment=XDG_RUNTIME_DIR=/run/anet-dmax
Environment=NO_PROXY=127.0.0.1,localhost
ExecStart=/opt/anet/bin/anet daemon
Restart=on-failure
RestartSec=5s

NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ReadWritePaths=/var/lib/anet-dmax
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged
SystemCallErrorNumber=EPERM
UMask=0077
MemoryMax=1G
CPUQuota=200%
TasksMax=256

[Install]
WantedBy=multi-user.target
