{
  "mcpServers": {
    "anet": {
      "type": "stdio",
      "command": "sh",
      "args": [
        "${CLAUDE_PLUGIN_ROOT}/bin/anet-mcp.sh"
      ],
      "env": {
        "ANET_PLUGIN_IDENTITY": "${user_config.identity}",
        "ANET_PLUGIN_BIN": "${user_config.anetPath}"
      },
      "timeout": 900000
    }
  }
}
