# C anet-docs: the anet-official instance behind this identity.
# Read by anet-official-backend@%i.service. LISTEN is the backend's Unix socket, in the
# unit's RuntimeDirectory (/run/anet-official/anet-docs); the url entries in config.json name
# the same socket (anet-official service-config -url unix:///run/anet-official/anet-docs/backend.sock).
LISTEN=unix:/run/anet-official/anet-docs/backend.sock
# CAP_GROUPS rather than GROUPS: bash reserves GROUPS and silently drops it when
# this file is sourced by hand.
CAP_GROUPS=docs
