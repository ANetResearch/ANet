# E anet-paid-demo: the anet-official instance behind this identity.
# Read by anet-official-backend@%i.service. LISTEN must be a loopback address and
# match the host:port of the url entries in config.json.
LISTEN=127.0.0.1:8615
# CAP_GROUPS rather than GROUPS: bash reserves GROUPS and silently drops it when
# this file is sourced by hand.
CAP_GROUPS=paid
